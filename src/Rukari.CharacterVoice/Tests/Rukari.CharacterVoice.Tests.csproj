    <Compile Include="..\Runtime\WindowsVoiceFolderPicker.cs" Link="Runtime\WindowsVoiceFolderPicker.cs" />
    <Compile Include="..\Runtime\VoiceToolPage.cs" Link="Runtime\VoiceToolPage.cs" />
    <Compile Include="..\Runtime\VoicePlaybackSettingsPage.cs" Link="Runtime\VoicePlaybackSettingsPage.cs" />
