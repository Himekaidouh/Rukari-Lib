<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Rukari.Lib.Runtime</AssemblyName>
    <RootNamespace>Rukari.Lib.Runtime</RootNamespace>
    <Version>0.4.3</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RequiresAzureArchiveGame>true</RequiresAzureArchiveGame>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\assets\rukari-lib\ui\**\*" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rukari.Lib\Rukari.Lib.csproj" Private="false" />
    <Reference Include="BepInEx.Core" HintPath="$(AzureArchiveBepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(AzureArchiveBepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="Il2Cppmscorlib" HintPath="$(AzureArchiveInterop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(AzureArchiveBepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(AzureArchiveInterop)\UnityEngine.CoreModule.dll" Private="false" Aliases="unitycore" />
    <Reference Include="UnityEngine" HintPath="$(AzureArchiveInterop)\UnityEngine.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(AzureArchiveInterop)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(AzureArchiveBepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(AzureArchiveInterop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(AzureArchiveInterop)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(AzureArchiveInterop)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(AzureArchiveInterop)\UnityEngine.TextRenderingModule.dll" Private="false" Aliases="unitytext" />
    <Reference Include="UnityEngine.UI" HintPath="$(AzureArchiveInterop)\UnityEngine.UI.dll" Private="false" Aliases="unityui" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(AzureArchiveInterop)\UnityEngine.UIModule.dll" Private="false" Aliases="unityuimodule" />
  </ItemGroup>
</Project>
